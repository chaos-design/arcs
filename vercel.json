{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "corepack pnpm install --frozen-lockfile",
  "buildCommand": "corepack pnpm site:build",
  "outputDirectory": "site/dist",
  "rewrites": [{ "source": "/((?!.*\\..*).*)", "destination": "/index.html" }]
}
