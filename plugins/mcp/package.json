      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@chaos-design/arcs-core": "workspace:*",
    "@chaos-design/arcs-plugin-kit": "workspace:*",
    "@chaos-design/arcs-telemetry": "workspace:*",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  }
}
