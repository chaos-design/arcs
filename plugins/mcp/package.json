{
  "name": "@chaos-design/arcs-plugin-mcp",
  "version": "0.1.0",
  "description": "ARCS MCP 透明代理网关：在 MCP 宿主与下游 Server 之间实时纠偏（L1-L3），L4 按拒绝语义阻断",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
