{
  "name": "@chaos-design/arcs-plugin-workbuddy",
  "version": "0.1.0",
  "description": "ARCS WorkBuddy 宿主插件：25 hooks，--event 模式，Tier B 前置纠偏（L1-L3 + 注入，L4 降级为 block）",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "arcs-plugin-workbuddy": "./dist/cli.js"
  },
  "files": [
    "dist",
    "hooks",
    ".codebuddy-plugin",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@chaos-design/arcs-core": "workspace:*",
    "@chaos-design/arcs-host-kit": "workspace:*",
    "@chaos-design/arcs-plugin-kit": "workspace:*",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  }
}
