{
  "name": "@chaos-design/arcs-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ARCS 文档静态站点（配置驱动的多页静态生成器，构建时内嵌 docs 中英双语，真实 Mermaid SVG 渲染）。",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "node scripts/build.mjs && vite preview --host 127.0.0.1 --port 5175",
    "build": "node scripts/build.mjs",
    "site:build": "pnpm build",
    "preview": "vite preview",
    "lint": "python3 -c \"import ast, pathlib; ast.parse(pathlib.Path('scripts/docs_site.py').read_text(encoding='utf-8'))\" && node -e \"JSON.parse(require('fs').readFileSync('site.config.json','utf8'))\""
  },
  "dependencies": {
    "mermaid": "^11.11.0"
  },
  "devDependencies": {
    "vite": "^7.3.8"
  }
}
