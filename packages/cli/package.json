{
  "name": "@chaos-design/arcs-cli",
  "version": "0.1.0",
  "description": "ARCS 统一命令行：一条命令发现并快速启动各宿主插件服务",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "arcs": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@chaos-design/arcs-plugin-mcp": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  }
}
